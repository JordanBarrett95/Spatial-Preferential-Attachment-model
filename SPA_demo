      " [0.92897428 0.0145879 ]\n",
      " [0.74506917 0.50817951]]\n"
     ]
    }
   ],
   "source": [
    "print(spa_graph.positions)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ce1b233e-2a84-44f9-80a2-194ab79d90d4",
   "metadata": {},
   "source": [
    "We can also update the graph."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "27dc0806-fe7c-48af-a089-e2247ba0f5f6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "SPA(n=100, m=192, dimension=2, norm=inf, backend='periodic grids')\n"
     ]
    }
   ],
   "source": [
    "spa_graph.update(90)\n",
    "print(spa_graph)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f9784f01-3813-4537-8d8b-dbe183089217",
   "metadata": {},
   "source": [
    "# Saving and loading graphs"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "706c031f-9553-4017-bce8-771dc70c8772",
   "metadata": {},
   "source": [
    "This feature was implemented before the code was lightning fast, and is probably not even useful anymore. Nonetheless, it is still a feature.\n",
    "\n",
    "We can save a range of spa graphs with varying parameters."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "ac08777b-cf16-4056-9ce1-012d91e7dcce",
   "metadata": {},
   "outputs": [],
   "source": [
    "n_values = [1000, 2000]\n",
    "p_values = [0.5, 0.75]\n",
    "A1_values = [1]\n",
    "A2_values = [1, 2]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "e19e177b-27b6-4a83-9588-2270c6a8d699",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "n=1000, p=0.5, A1=1, A2=1, dimension=2, norm=inf, alpha=0.65\n",
      "n=1000, p=0.5, A1=1, A2=2, dimension=2, norm=inf, alpha=0.65\n",
      "n=1000, p=0.75, A1=1, A2=1, dimension=2, norm=inf, alpha=0.65\n",
      "n=1000, p=0.75, A1=1, A2=2, dimension=2, norm=inf, alpha=0.65\n",
      "n=2000, p=0.5, A1=1, A2=1, dimension=2, norm=inf, alpha=0.65\n",
      "n=2000, p=0.5, A1=1, A2=2, dimension=2, norm=inf, alpha=0.65\n",
      "n=2000, p=0.75, A1=1, A2=1, dimension=2, norm=inf, alpha=0.65\n",
      "n=2000, p=0.75, A1=1, A2=2, dimension=2, norm=inf, alpha=0.65\n"
     ]
    }
   ],
   "source": [
    "SPA.save_spa_graphs(\n",
    "    filename=\"small-SPA-graphs\",\n",
    "    n_values=n_values,\n",
    "    p_values=p_values,\n",
    "    A1_values=A1_values,\n",
    "    A2_values=A2_values,\n",
    "    seed=seed,\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "acc325e6-750f-442a-b7f0-c61a92feccf3",
   "metadata": {},
   "source": [
    "We can then load a graph with specific parameters."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "9751aa22-c13f-49b4-a8e5-c53dd3a8d714",
   "metadata": {},
   "outputs": [
